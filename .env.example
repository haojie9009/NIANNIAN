# == 302.ai (Required) ==
AI302_API_KEY=s******************

# == Models ==
AI302_TEXT_MODEL=claude-sonnet-4-6
AI302_TEXT_FALLBACK=gpt-5.4
AI302_VISION_MODEL=gemini-2.0-pro-image-preview
AI302_IMAGE_GEN_MODEL=gemini-2.0-pro-image-preview
AI302_VIDEO_GEN_MODEL=kling-v1-5-pro
AI302_AUDIO_MODEL=whisper-1

# == Alibaba Qwen (NianNian Agent voice chat) ==
# Get key: https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-**************************

# == Optional local LLM ==
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_API_KEY=lm-studio
# LOCAL_LLM_MODEL=qwen3:8b

# == Mock Mode (zero API cost, hardcoded responses) ==
# NIAN_MOCK_MODE=1

# == Cache: Record → Playback workflow ==
# 1. NIAN_CACHE_MODE=record  → 跑一次真实 API，自动保存响应到 data/cache/
# 2. NIAN_CACHE_MODE=playback → 从缓存读取，零 API 消费
# 缓存按 (接口, 模型, 参数hash) 做 key，同参数只付一次费
# NIAN_CACHE_MODE=
